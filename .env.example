# Copy to .env and fill in. Never commit .env.

# --- Web UI login (required for management) ---
# Defaults if unset: admin / changeme  — change these before exposing the port!
CHECKIN_USER=admin
CHECKIN_PASSWORD=changeme
# Random string to sign session cookies (change in production)
CHECKIN_SESSION_SECRET=please-change-this-session-secret

# Data directory for SQLite (Docker sets /data)
# CHECKIN_DATA_DIR=./data

# CLI YAML ${VAR} placeholders (optional)
FORUM_DEMO_COOKIE=session_id=your_session_here
PORTAL_DEMO_TOKEN=your_bearer_token_here
HTTP_FORM_DEMO_COOKIE=uid=123;token=abc
NOTIFY_WEBHOOK_URL=

# Key that encrypts saved login passwords (recorded mode auto re-login).
# Unset = auto-generated /data/secret.key (back it up!). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CHECKIN_SECRET_KEY=
