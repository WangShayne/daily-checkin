# Copy to .env and fill in. Never commit .env.
# Used by CLI YAML ${VAR} placeholders. Web UI stores secrets in SQLite volume.

FORUM_DEMO_COOKIE=session_id=your_session_here
PORTAL_DEMO_TOKEN=your_bearer_token_here
HTTP_FORM_DEMO_COOKIE=uid=123;token=abc

NOTIFY_WEBHOOK_URL=

# Data directory for SQLite (Docker sets /data)
# CHECKIN_DATA_DIR=./data
