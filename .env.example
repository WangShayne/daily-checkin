# Copy to .env and fill in. Never commit .env.
# Reference these names in config.yaml via ${ENV_VAR} placeholders.

# Example site cookies / tokens
FORUM_DEMO_COOKIE=session_id=your_session_here
PORTAL_DEMO_TOKEN=your_bearer_token_here
HTTP_FORM_DEMO_COOKIE=uid=123;token=abc

# Optional notification webhook (Slack / Discord / custom)
NOTIFY_WEBHOOK_URL=

# Optional: path override (default: config.yaml in cwd)
# CHECKIN_CONFIG=config.yaml
